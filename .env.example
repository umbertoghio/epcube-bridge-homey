EPCUBE_EMAIL=you@example.com
EPCUBE_PASSWORD=replace-me
EPCUBE_REGION=EU
EPCUBE_TIMEZONE=Europe/Rome
POLL_INTERVAL_S=30
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_BASE_TOPIC=epcube
API_TOKEN=replace-with-a-long-random-secret
ENABLE_CONTROLS=false

# Skip dashboard login for trusted local access; REST still requires API_TOKEN.
WEB_DISABLE_AUTH=false

# Optional current weather; leave empty to disable.
WEATHER_LOCATION=Borgo San Dalmazzo
